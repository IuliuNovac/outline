# Outline .env template — rendered by scripts/install-outline.sh.
# Substitutions use underscore-delimited placeholders that won't collide
# with normal values.

# ── Compose project ────────────────────────────────────────────────────────
COMPOSE_PROJECT_NAME=_COMPOSE_PROJECT_NAME_

# ── Ports (host-side bindings, all 127.0.0.1) ──────────────────────────────
OUTLINE_PORT=_OUTLINE_PORT_
POSTGRES_PORT=_POSTGRES_PORT_
REDIS_PORT=_REDIS_PORT_
DEX_PORT=_DEX_PORT_

# ── Outline runtime ────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3000
URL=_OUTLINE_URL_
SECRET_KEY=_SECRET_KEY_
UTILS_SECRET=_UTILS_SECRET_
FORCE_HTTPS=false
WEB_CONCURRENCY=1
LOG_LEVEL=info
DEBUG=http
ENABLE_UPDATES=false
DEFAULT_LANGUAGE=en_US

# ── Postgres ───────────────────────────────────────────────────────────────
POSTGRES_USER=_POSTGRES_USER_
POSTGRES_PASSWORD=_POSTGRES_PASSWORD_
POSTGRES_DB=_POSTGRES_DB_
DATABASE_URL=postgres://_POSTGRES_USER_:_POSTGRES_PASSWORD_@postgres:5432/_POSTGRES_DB_
PGSSLMODE=disable

# ── Redis ──────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379

# ── OIDC (user→Outline via Dex; browser flow) ──────────────────────────────
OIDC_CLIENT_ID=outline
OIDC_CLIENT_SECRET=_OUTLINE_OIDC_CLIENT_SECRET_
OUTLINE_OIDC_CLIENT_SECRET=_OUTLINE_OIDC_CLIENT_SECRET_
OIDC_AUTH_URI=http://localhost:_DEX_PORT_/dex/auth
OIDC_TOKEN_URI=http://dex:5556/dex/token
OIDC_USERINFO_URI=http://dex:5556/dex/userinfo
OIDC_USERNAME_CLAIM=email
OIDC_DISPLAY_NAME=Local
OIDC_SCOPES=openid profile email

# ── Storage (file uploads) ─────────────────────────────────────────────────
FILE_STORAGE=local
FILE_STORAGE_LOCAL_ROOT_DIR=/var/lib/outline/data
FILE_STORAGE_UPLOAD_MAX_SIZE=262144000

# ── SMTP (disabled for local dev; admin@nova.local is just a label) ────────
SMTP_FROM_EMAIL=admin@nova.local

# ── Rate limiting ──────────────────────────────────────────────────────────
RATE_LIMITER_ENABLED=true

# ── Optional 3rd-party providers (off) ─────────────────────────────────────
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
